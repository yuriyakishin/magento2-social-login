            <block class="Yu\SocialLogin\Block\Social\Button" name="yu.social.button.apple"
                   template="Yu_SocialLogin::social/buttons/apple.phtml">
                <arguments>
                    <argument name="provider_code" xsi:type="string">apple</argument>
