<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <yu_social_login>
            <general>
                <enabled>0</enabled>
            </general>
            <google>
                <enabled>0</enabled>
                <sort_order>10</sort_order>
                <label>Google</label>
                <adapter>Hybridauth\Provider\Google</adapter>
                <required_fields>client_id,client_secret</required_fields>
                <encrypted_fields>client_secret</encrypted_fields>
            </google>
            <facebook>
                <enabled>0</enabled>
                <sort_order>20</sort_order>
                <label>Facebook</label>
                <adapter>Hybridauth\Provider\Facebook</adapter>
                <required_fields>client_id,client_secret</required_fields>
                <encrypted_fields>client_secret</encrypted_fields>
            </facebook>
            <x_twitter>
                <enabled>0</enabled>
                <sort_order>30</sort_order>
                <label>X</label>
                <adapter>Hybridauth\Provider\X</adapter>
                <required_fields>client_id,client_secret</required_fields>
                <encrypted_fields>client_secret</encrypted_fields>
            </x_twitter>
            <github>
                <enabled>0</enabled>
                <sort_order>40</sort_order>
                <label>GitHub</label>
                <adapter>Hybridauth\Provider\GitHub</adapter>
                <required_fields>client_id,client_secret</required_fields>
                <encrypted_fields>client_secret</encrypted_fields>
            </github>
            <amazon>
                <enabled>0</enabled>
                <sort_order>50</sort_order>
                <label>Amazon</label>
                <adapter>Hybridauth\Provider\Amazon</adapter>
                <required_fields>client_id,client_secret</required_fields>
                <encrypted_fields>client_secret</encrypted_fields>
            </amazon>
            <yahoo>
                <enabled>0</enabled>
                <sort_order>60</sort_order>
                <label>Yahoo</label>
                <adapter>Hybridauth\Provider\Yahoo</adapter>
                <required_fields>client_id,client_secret</required_fields>
                <encrypted_fields>client_secret</encrypted_fields>
            </yahoo>
            <linkedin>
                <enabled>0</enabled>
                <sort_order>70</sort_order>
                <label>LinkedIn</label>
                <adapter>Hybridauth\Provider\LinkedInOpenID</adapter>
                <required_fields>client_id,client_secret</required_fields>
                <encrypted_fields>client_secret</encrypted_fields>
            </linkedin>
            <apple>
                <enabled>0</enabled>
                <sort_order>80</sort_order>
                <label>Apple</label>
                <adapter>Yu\SocialLogin\Model\HybridAuth\Provider\Apple</adapter>
                <required_fields>client_id,team_id,key_id,key_content</required_fields>
                <encrypted_fields>key_content</encrypted_fields>
            </apple>
            <microsoft>
                <enabled>0</enabled>
                <sort_order>90</sort_order>
                <label>Microsoft</label>
                <adapter>Hybridauth\Provider\MicrosoftGraph</adapter>
                <required_fields>client_id,client_secret</required_fields>
                <encrypted_fields>client_secret</encrypted_fields>
                <!-- The adapter's default scope adds contacts.read and offline_access;
                     login needs neither, and extra scopes inflate the consent screen. -->
                <scope>openid user.read</scope>
            </microsoft>
        </yu_social_login>
    </default>
</config>
