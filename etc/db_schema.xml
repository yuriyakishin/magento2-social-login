<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="yu_social_login" resource="default" engine="innodb" comment="Yu Social Login Accounts">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="provider" length="50" nullable="false" comment="Provider Code"/>
        <column xsi:type="varchar" name="social_id" length="255" nullable="false" comment="Provider User ID"/>
        <column xsi:type="varchar" name="email" length="255" nullable="true" comment="Email From Provider"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="YU_SOCIAL_LOGIN_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="yu_social_login" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="YU_SOCIAL_LOGIN_PROVIDER_SOCIAL_ID">
            <column name="provider"/>
            <column name="social_id"/>
        </constraint>
        <index referenceId="YU_SOCIAL_LOGIN_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>
</schema>
